{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/p/:path*",
      "destination": "/p/:path*"
    },
    {
      "source": "/og/:path*",
      "destination": "/og/:path*"
    },
    {
      "source": "/((?!p/|og/|assets/|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
